# This is an example environment file
# Copy this to .env for local development if needed
# For production, environment variables are set in docker-compose.yml

# Node environment (production or development)
NODE_ENV=production

# Server configuration
PORT=3000
HOST=0.0.0.0

# API Configuration
# Backend API URL (defaults to https://api.crimpy.app if not set)
PUBLIC_API_URL=https://devapi.crimpy.app
